        ],
        "dataCategory": "Time",
        "lineageTag": "095fb6f2-3cfe-4286-be50-e0887ad64e37",
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "expression": "ADDCOLUMNS ( CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2025, 12, 31 ) ), \"Year\", YEAR ( [Date] ), \"Month No\", MONTH ( [Date] ), \"Month\", FORMAT ( [Date], \"MMM\" ), \"Year Month\", FORMAT ( [Date], \"YYYY-MM\" ), \"Quarter\", \"Q\" & QUARTER ( [Date] ) )",
              "type": "calculated"
            }
          }
        ]
