            "formatString": "#,0.00",
            "lineageTag": "abf51037-9e28-42c4-8bf2-1f891fccc75f",
            "sourceColumn": "NetRevenue",
            "summarizeBy": "sum"
          },
          {
            "name": "CostAmount",
            "dataType": "double",
            "formatString": "#,0.00",
            "lineageTag": "8488c6a7-1a57-4c51-b480-5d496d604c99",
            "sourceColumn": "CostAmount",
            "summarizeBy": "sum"
          },
          {
            "name": "GrossProfit",
            "dataType": "double",
            "formatString": "#,0.00",
            "lineageTag": "32432a61-df4c-4084-ac24-78047a5a5fa6",
            "sourceColumn": "GrossProfit",
            "summarizeBy": "sum"
          },
          {
            "name": "Price Segment",
            "dataType": "string",
            "expression": "SWITCH ( TRUE (), vw_SalesLines[ListPrice] < 30, \"1 Budget (<30)\", vw_SalesLines[ListPrice] < 100, \"2 Mid (30-99)\", \"3 Premium (100+)\" )",
            "isDataTypeInferred": true,
            "lineageTag": "3681858f-4e86-4f83-a1e0-1efd4f7d0f40",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Customer Type",
            "dataType": "string",
            "expression": "SWITCH ( TRUE (), vw_SalesLines[ChannelName] = \"Retail Partner\", \"Retail partner (B2B)\", ISBLANK ( vw_SalesLines[CustomerID] ), \"Walk-in (anonymous)\", vw_SalesLines[IsInsider], \"Insider member\", \"Registered, non-member\" )",
            "isDataTypeInferred": true,
            "lineageTag": "1f048abf-d056-42d8-9ec2-75b391d53393",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "74ede255-04bf-4e77-b7fb-c6b0c69097bf",
        "measures": [
          {
            "name": "Revenue",
            "expression": "CALCULATE ( SUM ( vw_SalesLines[NetRevenue] ), vw_SalesLines[OrderStatus] = \"Completed\" )",
            "formatString": "\\€ #,0",
            "lineageTag": "8e573333-4f57-428b-9686-09afb634ae6b"
          },
          {
            "name": "Gross Profit",
            "expression": "CALCULATE ( SUM ( vw_SalesLines[GrossProfit] ), vw_SalesLines[OrderStatus] = \"Completed\" )",
            "formatString": "\\€ #,0",
            "lineageTag": "ee6bc691-6b8f-4ecb-90c2-fcd9af79c951"
          },
          {
            "name": "Margin %",
            "expression": "DIVIDE ( [Gross Profit], CALCULATE ( SUM ( vw_SalesLines[NetRevenue] ), vw_SalesLines[OrderStatus] = \"Completed\", NOT ISBLANK ( vw_SalesLines[CostAmount] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "a21cb484-f426-4e68-a154-22c07dd6d565"
          },
          {
            "name": "Orders",
            "expression": "CALCULATE ( DISTINCTCOUNT ( vw_SalesLines[OrderID] ), vw_SalesLines[OrderStatus] = \"Completed\" )",
            "formatString": "#,0",
            "lineageTag": "9e07f85f-0066-4489-8806-c2ab48c13706"
          },
          {
            "name": "Units",
            "expression": "CALCULATE ( SUM ( vw_SalesLines[Quantity] ), vw_SalesLines[OrderStatus] = \"Completed\" )",
            "formatString": "#,0",
            "lineageTag": "206655a6-530c-46b6-94cc-1ecfaea6b13f"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE ( [Revenue], [Orders] )",
            "formatString": "\\€ #,0.00",
            "lineageTag": "3c273d8b-cdad-497d-971a-0612748bb8f0"
          },
          {
            "name": "Revenue PY",
            "expression": "CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )",
            "formatString": "\\€ #,0",
            "lineageTag": "5f73cb4b-7c8d-44b4-868b-47d354c7e387"
          },
          {
            "name": "Revenue YoY %",
            "expression": "IF ( HASONEVALUE ( 'Date'[Year] ), DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] ) )",
            "formatString": "0.0%",
            "lineageTag": "35242a73-e941-4f60-8df1-8b03e7bb3818"
          },
          {
            "name": "Return Rate %",
            "expression": "DIVIDE ( CALCULATE ( DISTINCTCOUNT ( vw_SalesLines[OrderID] ), vw_SalesLines[OrderStatus] = \"Returned\" ), DISTINCTCOUNT ( vw_SalesLines[OrderID] ) )",
            "formatString": "0.0%",
            "lineageTag": "03d4d081-ff43-489f-a628-eaea12826be2"
          },
          {
            "name": "Revenue Top 10 Lines",
            "expression": "VAR r = RANKX ( ALLSELECTED ( vw_SalesLines[ProductLine] ), [Revenue], , DESC, DENSE ) RETURN IF ( HASONEVALUE ( vw_SalesLines[ProductLine] ) && r <= 10, [Revenue] )",
            "formatString": "\\€ #,0",
            "lineageTag": "527c4ea2-fdab-495a-bc0e-f6d042f43200"
          },
          {
            "name": "Avg Order Value Consumer",
            "expression": "CALCULATE ( [Avg Order Value], vw_SalesLines[ChannelName] <> \"Retail Partner\" )",
            "formatString": "\\€ #,0.00"
          }
        ],
        "partitions": [
          {
            "name": "vw_SalesLines",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(SqlServer, \"LegoSalesAnalytics\"),",
                "    dbo_vw_SalesLines = Source{[Schema=\"dbo\",Item=\"vw_SalesLines\"]}[Data]",
                "in",
                "    dbo_vw_SalesLines"
              ],
              "type": "m"
            }
          }
        ]
